<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="StateContext" Id="{51d73cf9-58e6-41b3-94a4-99b47f9c4816}">
    <Declaration><![CDATA[TYPE StateContext :
STRUCT
	rLevel: LREAL;
	sHmiStatusText: Str;
	bHmiAcknowledge: BOOL;
	bSafetyStop: BOOL;
	
	smgr: StateManager;
	
	// States
	aborted: StateAborted(THIS^);
	stopped: StateStopped(THIS^);
	idle: StateIdle(THIS^);
	execute: StateExecute(THIS^);
	suspended: StateSuspended(THIS^);
	held: StateHeld(THIS^);
	complete: StateComplete(THIS^);
	
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>